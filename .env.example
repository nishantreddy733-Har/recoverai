# Razorpay Test Mode API credentials. Never use rzp_live_ keys in this prototype.
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_test_key_secret

# A separate secret you choose when configuring the Razorpay Test Mode webhook.
# Use a unique value of at least 32 characters.
RAZORPAY_WEBHOOK_SECRET=replace_with_your_test_mode_webhook_secret
